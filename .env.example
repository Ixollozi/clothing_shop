# Copy to .env or set in hosting panel (examples only — no real secrets)

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false

# Celery: в проде — Redis + worker. Локально при DJANGO_DEBUG=true Celery eager (Redis не нужен).
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# Явно: CELERY_TASK_ALWAYS_EAGER=false

# Shared bot for all shops (optional if token is set in Admin → Telegram — настройки)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YourSharedNotifyBot
SITE_TELEGRAM_CODE=shop01
TELEGRAM_BIND_SHARED_SECRET=generate-a-long-random-string-per-shop

# Optional
SITE_PUBLIC_URL=https://shop01.example.com

# Central registrar (separate process), not the Django app
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_REGISTRAR_SITES_JSON={"shop01":{"base_url":"https://shop01.example.com","bind_secret":"same-as-TELEGRAM_BIND_SHARED_SECRET"}}
